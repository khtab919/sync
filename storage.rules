rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Payment receipts are private. A user can upload a new image only once;
    // clients cannot replace evidence or access anyone else's receipt.
    match /payment-receipts/{userId}/{requestId} {
      allow get: if request.auth != null &&
                    request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.size > 0 &&
                       request.resource.size < 8 * 1024 * 1024 &&
                       request.resource.contentType is string &&
                       request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
