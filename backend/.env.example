LAYALI_DOMAIN=165-227-128-113.sslip.io
ALLOWED_HOSTS=165-227-128-113.sslip.io
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=layali
POSTGRES_USER=layali
POSTGRES_PASSWORD=replace-with-a-different-long-random-secret
DB_HOST=db

# Deployment generates a unique relay secret; these values are CI/examples only.
LAYALI_TURN_SECRET=replace-this-with-a-unique-random-secret
LAYALI_TURN_HOST=api.example.com
LAYALI_TURN_PUBLIC_IP=203.0.113.1

# NOWPayments merchant credentials: set only on the server, never in Android.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Live SFU credentials are generated on the server, never included in the APK.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://165-227-128-113.sslip.io/livekit
LAYALI_LIVE_ENABLED=0
LAYALI_MAX_LIVE_ROOMS=5

# Server-only service account JSON; never commit or include it in the APK.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

MEDIA_PROBE_ENABLED=1
