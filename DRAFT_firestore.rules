rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() {
      let a = get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
      return a.status == 'active' || (a.status == 'suspended' && a.suspendedUntilMs <= request.time.toMillis());
    }
    // Financial records, account roles and moderation are server-owned.
    match /accounts/{uid} { allow get: if signedIn() && request.auth.uid == uid; }
    match /wallets/{uid} { allow get: if signedIn() && request.auth.uid == uid && active(); }
    match /creatorBalances/{uid} { allow get: if signedIn() && request.auth.uid == uid && active(); }
    match /{document=**} { allow read, write: if false; }
  }
}
